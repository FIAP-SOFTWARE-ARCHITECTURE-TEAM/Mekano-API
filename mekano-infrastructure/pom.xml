<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap</groupId>
        <artifactId>mekano</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mekano-infrastructure</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.fiap</groupId>
            <artifactId>mekano-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Quarkus extensions — versões gerenciadas pelo BOM -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        
        <!-- quarkus-flyway aqui pois adapter não está no classpath em `./mvnw test -pl mekano-infrastructure -am` -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>

        <!-- EXT-08: SmallRye Fault Tolerance — @Retry, @Timeout em UserRepositoryImpl (D-01).
             Declarada AQUI (não em adapter) porque as anotações MP-FT são processadas em
             compile-time no módulo onde residem. mekano-rest→mekano-infrastructure é
             runtime-scope; relação inversa não existe. Ver .planning/phases/07-fault-tolerance/07-CONTEXT.md. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>

        <!-- Quarkus Elytron Security Common — BcryptUtil usado por BcryptPasswordHasher
             (Plan 10-01: interface PasswordHasher no domínio, impl no infrastructure). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-elytron-security-common</artifactId>
        </dependency>

        <!-- SmallRye JWT Build API — RefreshTokenService gera tokens JWT internos
             (Plan 09-01; já presente no adapter mas necessário em compile-time aqui). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt-build</artifactId>
        </dependency>

        <!-- Cache Caffeine para leituras de usuário (D-13) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-cache</artifactId>
        </dependency>

        <!-- MapStruct — geração automática de mappers entre UserEntity ↔ User (Plan 09-05).
             Reabilitado após isolamento do bug quarkus-maven-plugin generate-code. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Quarkus JUnit5 — escopo test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AssertJ — fluent assertions em testes de integração -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- OBRIGATÓRIO: UserRepositoryImpl (Fase 4) precisará do index CDI (MOD-07, Gotcha 2) -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Lombok → lombok-mapstruct-binding → mapstruct-processor (ordem obrigatória — G3).
                 Reabilitado no Plan 09-05 (Phase 9). -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
