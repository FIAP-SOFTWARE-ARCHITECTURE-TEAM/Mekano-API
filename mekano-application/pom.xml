<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap</groupId>
        <artifactId>mekano</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mekano-application</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.fiap</groupId>
            <artifactId>mekano-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CDI para @ApplicationScoped nos use cases (APP-01) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- JUnit 5 — test runner (mesmo padrão do módulo domain) -->
        <!-- Versão gerenciada pelo Quarkus BOM 3.36.0 — NÃO adicionar <version> -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito puro — sem container Quarkus (decisão D5 — CONTEXT.md) -->
        <!-- NÃO usar io.quarkus:quarkus-junit5-mockito (inicia container) -->
        <!-- Versão gerenciada pelo Quarkus BOM 3.36.0 — NÃO adicionar <version> -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- OBRIGATÓRIO: CDI beans (@ApplicationScoped) não seriam descobertos sem este index (MOD-07, Gotcha 2) -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
