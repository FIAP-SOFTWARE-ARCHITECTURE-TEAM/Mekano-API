region             = "us-east-1"
environment        = "dev"
cluster_name       = "mekano-eks"
kubernetes_version = "1.34"

node_instance_types = ["t3.medium"]

db_name              = "mekano"
db_username          = "mekano"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_multi_az          = false

# Do not commit the real password here.
# Prefer: $env:TF_VAR_db_password="your-strong-password"
# db_password = "CHANGE_ME"

# Optional: IAM principal used by GitHub Actions for kubectl access.
# github_actions_principal_arn = "arn:aws:iam::123456789012:role/github-actions-mekano"
