# --- Database ---
DB_USER=mekano
DB_PASSWORD=mekano

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://evolution-api:5033
EVOLUTION_API_KEY=change_me_global_api_key
EVOLUTION_INSTANCE_NAME=mekano
EVOLUTION_INSTANCE_TOKEN=change_me_instance_token
EVOLUTION_DB_PASSWORD=evolution
# Token exigido pelo webhook /api/v1/webhooks/evolution (header x-webhook-token).
# A instância da Evolution API deve ser criada com webhookHeaders {"x-webhook-token": "<mesmo valor>"}.
EVOLUTION_WEBHOOK_TOKEN=change_me_webhook_token