<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap</groupId>
        <artifactId>mekano</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mekano-rest</artifactId>
    <packaging>quarkus</packaging>

    <dependencies>
        <!-- Módulos internos -->
        <dependency>
            <groupId>com.fiap</groupId>
            <artifactId>mekano-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fiap</groupId>
            <artifactId>mekano-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fiap</groupId>
            <artifactId>mekano-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- EXT-01: REST reativo com Jackson JSON — substitui quarkus-rest do scaffold -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- EXT-02: Hibernate ORM + Panache — funcional na Fase 4 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <!-- EXT-03: Flyway migrations — funcional na Fase 4 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!-- EXT-04: OpenAPI / Swagger UI em /q/swagger-ui -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <!-- EXT-05: Bean Validation (@Valid, @NotBlank) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <!-- EXT-??: SmallRye JWT — verificação de tokens e enforcement de @RolesAllowed -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt</artifactId>
        </dependency>
        <!-- EXT-XX: Logging JSON (reconhece quarkus.log.console.json.*) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <!-- EXT-XX: Jackson core (reconhece quarkus.jackson.*) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <!-- EXT-10: Driver JDBC PostgreSQL + ativa DevServices em test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- EXT-06: SmallRye Health — expõe /q/health, /q/health/live, /q/health/ready, /q/health/started.
             Auto-registra DataSourceHealthCheck para o datasource Agroal já presente. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- EXT-07: Micrometer + Prometheus registry — expõe /q/metrics em formato Prometheus.
             Extensão composta: puxa quarkus-micrometer transitivamente. Auto-binds:
             JVM, HTTP server, Agroal pool. (NÃO usar quarkus-smallrye-metrics — deprecated.) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- EXT-XX: Config YAML — lê application.yml de módulos dependentes -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>

        <!-- MapStruct — geração automática de mappers entre DTOs ↔ domínio (Plan 09-05).
             Reabilitado após isolamento do bug quarkus-maven-plugin generate-code. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- mapstruct-processor como provided: necessário para o Quarkus descobrir
             o processador de anotação quando quarkus-maven-plugin tem extensions=true
             (o annotationProcessorPaths do maven-compiler-plugin NÃO é honrado pelo
             compilador interno do Quarkus). -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok — geração de getters/setters para CreateUserRequest -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- H2 in-memory — Para testes -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mockito -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ — asserções fluentes para testes de Fault Tolerance (Plan 10-04) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ÚNICO módulo com quarkus-maven-plugin (MOD-06, Gotcha 1).
                 extensions=true já vincula automaticamente o goal build à fase compile. -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <!-- Jandex explícito conforme MOD-07 -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Lombok → lombok-mapstruct-binding → mapstruct-processor (ordem obrigatória — G3) -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.unmappedTargetPolicy=WARN</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- JaCoCo: merge + report-aggregate + check (aggregate coverage gate) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- Combina todos os .exec dos módulos dependentes em um único arquivo -->
                    <execution>
                        <id>jacoco-merge</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/../mekano-domain/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                                <fileSet>
                                    <directory>${project.basedir}/../mekano-application/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                                <fileSet>
                                    <directory>${project.basedir}/../mekano-infrastructure/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <!-- Relatório unificado HTML/XML/CSV -->
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/*Dto.class</exclude>
                                <exclude>**/*DTO.class</exclude>
                                <exclude>**/*Request.class</exclude>
                                <exclude>**/*Response.class</exclude>
                                <exclude>**/*ExceptionMapper.class</exclude>
                                <exclude>**/*Config.class</exclude>
                                <exclude>**/*Resource.class</exclude>
                                <exclude>**/*Entity.class</exclude>
                                <exclude>**/*MapperImpl.class</exclude>
                                <exclude>**/*PanacheRepository*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
